---
import Container from '../../components/Container.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreReference from '../../components/ScoreReference.astro';
import { formatCurveValue, generateSquareRootCurveChart } from '../../lib/squareRootCurve';

const canonical = 'https://squarerootcurve.com/square-root-curve-chart/';
const chartEntries = generateSquareRootCurveChart();
const desktopGroupSize = Math.ceil(chartEntries.length / 3);
const desktopGroups = Array.from({ length: 3 }, (_, groupIndex) =>
  chartEntries.slice(groupIndex * desktopGroupSize, (groupIndex + 1) * desktopGroupSize),
);
const perfectSquares = new Set([0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100]);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: 'Square Root Curve Table (0–100)',
    description: 'Search the 0–100 square root curve table, calculate a score and print the complete chart.',
    breadcrumb: { '@id': `${canonical}#breadcrumb` },
    isPartOf: { '@id': 'https://squarerootcurve.com/#website' },
    inLanguage: 'en',
  }, {
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://squarerootcurve.com/' },
      { '@type': 'ListItem', position: 2, name: 'Square Root Curve Table', item: canonical },
    ],
  }],
};
---

<BaseLayout
  title="Square Root Curve Table & Chart (0–100) | SquareRootCurve.com"
  description="Find any score in the 0–100 square root curve table. Filter original grades, calculate curved results, explore examples and print the complete chart."
  canonical={canonical}
  structuredData={structuredData}
  navigationItems={[
    { label: 'Calculator', href: '/#calculator' },
    { label: 'Chart', href: '#chart' },
    { label: 'Formula', href: '/#formula' },
  ]}
>
  <Container class="opening">
    <header class="opening-copy">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">Square Root Curve Table</span></nav>
      <h1>Square Root Curve Table (0–100)</h1>
      <p class="lede">Look up grades with 10 × √score, or print the complete 0–100 chart.</p>
    </header>

    <section id="chart" class="chart-section" aria-labelledby="chart-title">
      <ScoreReference>
      <div slot="table-heading" class="chart-heading">
        <div class="chart-title-group">
          <h2 id="chart-title">Complete 0–100 Score Chart</h2>
        </div>
        <div class="chart-actions">
          <div class="chart-action-buttons">
            <button class="print-chart" type="button">Print chart</button>
            <a class="download-pdf" href="/square-root-curve-chart.pdf" download aria-describedby="export-help">
              Download PDF
            </a>
          </div>
          <p id="export-help" class="export-help">
            Download the complete one-page PDF, or use Print chart to print.
          </p>
        </div>
      </div>

      <p class="score-shortcuts">
        Common score answers:
        {[66, 72, 77, 86].map((raw, index) => (
          <>{index > 0 && ' · '}<a class="reference-link" href={`#score-example-${raw}`}>{raw}% → {formatCurveValue(chartEntries[raw].curved)}%</a></>
        ))}
      </p>
      </ScoreReference>

      <div class="print-heading" aria-hidden="true">
        <div class="print-brand">
          <p>SquareRootCurve.com</p>
          <p>Grading Reference</p>
        </div>
        <h2>Square Root Curve Chart</h2>
        <p class="print-formula">Curved grade = 10 × √raw grade</p>
        <p class="print-description">
          Use this chart to convert raw percentage scores to square root curved grades.
        </p>
      </div>

      <div class="chart-table chart-table-desktop">
        <table>
          <caption class="sr-only">
            Square root curved grades for raw scores from 0 through 100, arranged in three groups.
          </caption>
          <thead>
            <tr>
              {desktopGroups.map(() => (
                <>
                  <th scope="col">Raw</th>
                  <th scope="col">Curved</th>
                </>
              ))}
            </tr>
          </thead>
          <tbody>
            {Array.from({ length: desktopGroupSize }, (_, rowIndex) => (
              <tr>
                {desktopGroups.map((group) => {
                  const entry = group[rowIndex];
                  return entry ? (
                    <>
                      <td class:list={['chart-raw', { 'is-anchor': perfectSquares.has(entry.raw) }]}>
                        {entry.raw}
                      </td>
                      <td class:list={['chart-curved', { 'is-anchor': perfectSquares.has(entry.raw) }]}>
                        {formatCurveValue(entry.curved)}
                      </td>
                    </>
                  ) : (
                    <>
                      <td class="chart-empty" aria-hidden="true"></td>
                      <td class="chart-empty" aria-hidden="true"></td>
                    </>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <footer class="print-footer" aria-hidden="true">
        <p>SquareRootCurve.com</p>
        <p>Values rounded to one decimal place where needed.</p>
      </footer>
    </section>

    <section class="formula-reference-section reference-section" aria-labelledby="table-formula-title">
      <header class="reference-heading">
        <h2 id="table-formula-title">How to calculate a square root curved score</h2>
      </header>
      <p class="calculation-line">Curved Score = 10 × √(Original Score)</p>
      <p>Use an original score on a 0–100 percentage scale. Take its square root, then multiply by 10. Results below are rounded to the nearest tenth; calculations keep full precision. For a test out of another total, convert earned points to a percentage first.</p>
      <div class="formula-methods">
        {[66, 72, 77, 86].map((raw) => (
          <article id={`score-example-${raw}`}>
            <h3>What is {raw} on a square root curve?</h3>
            <p class="calculation-line">10 × √{raw} ≈ {formatCurveValue(chartEntries[raw].curved)}%</p>
            <p>An original score of {raw}% becomes approximately {formatCurveValue(chartEntries[raw].curved)}%, a gain of {formatCurveValue(chartEntries[raw].curved - raw)} percentage points.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="reference-section faq-section" aria-labelledby="table-faq-title">
      <header class="reference-heading"><h2 id="table-faq-title">Square root curve table questions</h2></header>
      <div class="faq-list">
        <details><summary>How do I find my score in the table?</summary><p>Find your original percentage in the left column and read its curved percentage in the right column. Use the filter to narrow the whole-number rows, or enter a decimal in the score selector for a live result.</p></details>
        <details><summary>Do 0 and 100 change?</summary><p>No. Zero stays 0% and 100 stays 100%. Scores between these endpoints increase under this formula.</p></details>
        <details><summary>Why is my result different from my teacher’s grade?</summary><p>Your teacher may use a different curve or rounding policy. This table uses 10 × √score and displays up to one decimal place; confirm the grading policy before treating it as an official grade.</p></details>
        <details><summary>Can I use points instead of a percentage?</summary><p>Convert points first: 36 out of 50 is 72%, which curves to approximately {formatCurveValue(chartEntries[72].curved)}%. The <a class="reference-link" href="/#points-calculator">points-based calculator</a> performs that conversion for you.</p></details>
        <details><summary>How do I save or print the full table?</summary><p>Choose Download PDF to save the complete one-page chart directly, or Print chart to open your browser’s print dialog. Both include all 101 scores, even when the onscreen table is filtered.</p></details>
      </div>
    </section>

    <section class="more-calculators" aria-labelledby="next-step-title">
      <header class="more-calculators-heading">
        <div class="section-kicker"><span aria-hidden="true">02</span><span>Calculate</span></div>
        <h2 id="next-step-title">Calculate a Square Root Curved Grade</h2>
        <p>
          Use the <a class="reference-link" href="/#calculator">Square Root Curve Calculator</a> for a live result,
          or review the <a class="reference-link" href="/#formula">formula and worked examples</a>.
          To compare other methods, use the <a class="reference-link" href="/grade-curve-calculator/">Grade Curve Calculator</a>.
          See our <a class="reference-link" href="/methodology/#verification">calculation checks</a>
          and <a class="reference-link" href="/methodology/#references">reference sources</a> for how the chart is verified.
        </p>
      </header>
    </section>
  </Container>
</BaseLayout>

<style>
  .chart-table-desktop { display: none; }
  .opening-copy nav { margin-bottom: var(--space-3); font-size: var(--text-sm); }
  .opening-copy > p:last-child { margin-top: var(--space-3); }
  .chart-section { padding-top: var(--space-4); }
  .chart-heading { padding-block: var(--space-3); }
  .chart-title-group h2 { font-size: 1.5rem; }
  .score-shortcuts { padding-block: var(--space-3); }
  .formula-methods article { scroll-margin-top: var(--space-4); }
</style>

<script>
  document.querySelector<HTMLButtonElement>('.print-chart')?.addEventListener('click', () => window.print());
</script>
